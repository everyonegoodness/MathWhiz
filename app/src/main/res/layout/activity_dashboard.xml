<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_stripes"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="24dp"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_main_panel"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spGrade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card" />

            <Spinner
                android:id="@+id/spSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spDateRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvError"
            style="@style/Text.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRetry"
            style="@style/Widget.MathWhiz.Button.Orange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/try_again"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmpty"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOverall"
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Text.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/most_missed" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/mostMissedChart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:padding="8dp" />

            <TextView
                style="@style/Text.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/by_skill" />

            <LinearLayout
                android:id="@+id/skillList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Text.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/missed_questions" />

            <LinearLayout
                android:id="@+id/questionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnViewAllQuestions"
                style="@style/Widget.MathWhiz.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_all"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history" />

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnViewAllHistory"
                style="@style/Widget.MathWhiz.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_all"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.MathWhiz.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/back_home" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_cream"
    android:keepScreenOn="true">

    <com.mathwhiz.app.ui.LoginBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:background="@drawable/bg_main_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                style="@style/Text.Number"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvStreak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                style="@style/Text.Number"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:gravity="center"
                style="@style/Text.Number"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                style="@style/Text.Number"
                android:textSize="16sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/questionScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvPrompt"
                    style="@style/Text.Question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/mw_ink"
                    app:autoSizeMaxTextSize="44sp"
                    app:autoSizeMinTextSize="20sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/tvVisual"
                    style="@style/Text.Number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/mw_ink"
                    app:autoSizeMaxTextSize="100sp"
                    app:autoSizeMinTextSize="24sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/bottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAnswer"
                style="@style/Text.Number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/mw_green_dark"
                android:textSize="22sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/feedbackPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:padding="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/mw_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnReveal"
                style="@style/Widget.MathWhiz.Button.Orange.Class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reveal" />

            <LinearLayout
                android:id="@+id/rowMark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnCorrect"
                    style="@style/Widget.MathWhiz.Button.Green.Class"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/correct" />

                <Button
                    android:id="@+id/btnWrong"
                    style="@style/Widget.MathWhiz.Button.Red.Class"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/wrong" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mcGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOptA"
                        style="@style/Widget.MathWhiz.Button.Blue.Class"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="18sp"
                        app:autoSizeMaxTextSize="22sp"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeTextType="uniform" />

                    <Button
                        android:id="@+id/btnOptB"
                        style="@style/Widget.MathWhiz.Button.Blue.Class"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="18sp"
                        app:autoSizeMaxTextSize="22sp"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOptC"
                        style="@style/Widget.MathWhiz.Button.Blue.Class"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="18sp"
                        app:autoSizeMaxTextSize="22sp"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeTextType="uniform" />

                    <Button
                        android:id="@+id/btnOptD"
                        style="@style/Widget.MathWhiz.Button.Blue.Class"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="18sp"
                        app:autoSizeMaxTextSize="22sp"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnNext"
            style="@style/Widget.MathWhiz.Button.Green.Class"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next_question"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/startPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStartTitle"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStartInfo"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/startProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvFruitStatus"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnStart"
            style="@style/Widget.MathWhiz.Button.Green"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="@string/start" />

        <Button
            android:id="@+id/btnStartBack"
            style="@style/Widget.MathWhiz.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_home" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTeacherMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_teacher_mode"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/teacher_mode_active"
        android:textColor="@color/mw_white"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
